  "sentences": [
    {
      "block": 0,
      "text": "You are in a prison.",
      "start": 0.0,
      "end": 1.6
    },
    {
      "block": 0,
      "text": "There are two doors.",
      "start": 1.78,
      "end": 3.62
    },
    {
      "block": 0,
      "text": "One leads to freedom and the other leads to certain death.",
      "start": 3.8,
      "end": 7.0
    },
    {
      "block": 0,
      "text": "There are also two guards in front of the doors.",
      "start": 7.18,
      "end": 9.9
    },
    {
      "block": 0,
      "text": "One always tell the truth while the other one always lies.",
      "start": 10.08,
      "end": 13.2
    },
    {
      "block": 0,
      "text": "You can ask only one question to one of the guards before you open one of the doors.",
      "start": 13.38,
      "end": 17.46
    },
    {
      "block": 0,
      "text": "What question do you ask?",
      "start": 17.64,
      "end": 19.48
    }
  ]
}
